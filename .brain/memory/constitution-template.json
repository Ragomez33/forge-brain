{
  "version": "1.0.0",
  "kind": "brain-corp/constitution",
  "description": "Centralized constitution of the .brain/ SDD engine. Prevails over any local instruction that contradicts it.",
  "memory": {
    "constitution": ".brain/memory/constitution.md",
    "template": ".brain/memory/constitution-template.json",
    "scope": "workspace"
  },
  "flow": [
    "TICK-XXX",
    "/init-work",
    "/specify",
    "/plan",
    "/tasks",
    "/implement",
    "/analyze",
    "PR",
    "/complete",
    "done/"
  ],
  "implementModes": ["checkpoint", "batch"],
  "phases": {
    "init-work": {
      "requires": ["ticket"],
      "produces": ["active.json", "features/<TICK-XXX>/", "contract.md"],
      "contractWhen": ["target_domain=shared", "repository.hasRelationships"]
    },
    "specify": {
      "requires": ["active.json"],
      "produces": ["spec.md"],
      "format": "EARS"
    },
    "plan": {
      "requires": ["spec.md"],
      "produces": ["plan.md"]
    },
    "tasks": {
      "requires": ["plan.md"],
      "produces": ["tasks.md"],
      "taskPattern": "- [ ] TXXX [P] `path` Description (REQ-XXX)"
    },
    "implement": {
      "requires": ["tasks.md"],
      "modes": ["checkpoint", "batch"],
      "produces": ["verified code", "updated tasks.md"]
    },
    "analyze": {
      "requires": ["spec.md", "tasks.md"],
      "produces": ["analysis.md"],
      "blocking": true
    }
  },
  "constraints": {
    "rootContainsBusinessLogic": false,
    "cdAllowed": false,
    "specsOutsideBrain": false,
    "speckitAllowed": false,
    "localSecrets": false,
    "autoGitWithoutApproval": false,
    "ticketRequiredForChange": true
  },
  "gates": [
    "spec: verifiable EARS requirements",
    "plan: covers all REQ-*",
    "tasks: atomic tasks with exact paths",
    "implementation: tests green",
    "analyze: no blocking drift",
    "sync: sanity check with no errors"
  ],
  "agentBehavior": {
    "readConstitutionFirst": true,
    "evidenceOverAssumption": true,
    "stopOnDrift": true,
    "askWhenAmbiguous": true,
    "neverInventRequirements": true
  }
}
